{
 "name": "159-date-formats",
 "description": "A date field reads a date mention in each format of SPEC 4.11 and admits the value in the normal form. A one-digit day or month, an ordinal suffix, an abbreviated month name with a dot, a month name in capitals and a line break in a mention are allowed. A wrong ordinal suffix, a mention with no year, and a mention next to a digit or a letter give no date. A value that is not in the normal form, or is not a real date, is TYPE_INVALID. A date in a format that the field does not list is DATE_FORMAT_UNDECLARED, and a date after the maximum is DATE_OUT_OF_RANGE (#612).",
 "document": "In force from 1 July 2025. Signed 2025-06-15. Filed on 15/06/2025, posted 6/20/2025 and stamped 21.6.2025. The board met on June 2, 2025 and again on 3rd Jul. 2025. Reviewed 9 AUGUST 2025. Due by 30\nSeptember 2025. Paid Sept 5 2025. Closed 1th May 2025. Ref 12025-07-01 and 2025-07-01T10:00.\n",
 "schema": {
  "fields": {
   "day": {
    "type": "date",
    "formats": [
     "YYYY-MM-DD",
     "D/M/YYYY",
     "M/D/YYYY",
     "D.M.YYYY",
     "D Month YYYY",
     "Month D, YYYY"
    ],
    "multiple": true
   },
   "iso": {
    "type": "date",
    "formats": [
     "YYYY-MM-DD"
    ],
    "maximum": "2025-06-30",
    "multiple": true
   }
  }
 },
